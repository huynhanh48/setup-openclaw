# =============================================================================
#  OpenClaw + Tailscale + n8n Docker Environment
#  3 services: openclaw-gateway | tailscale-proxy | n8n
#  Copy file này thành .env và điền giá trị thực tế:
#    cp .env.template .env
# =============================================================================

# -----------------------------------------------------------------------------
#  OpenClaw Docker Image
# -----------------------------------------------------------------------------
# Phiên bản image có sẵn trên Docker Hub. Dùng tag cụ thể để tránh breaking changes.
# Xem tất cả tags: https://hub.docker.com/r/alpine/openclaw/tags
OPENCLAW_IMAGE=alpine/openclaw:latest

# -----------------------------------------------------------------------------
#  OpenClaw Gateway
# -----------------------------------------------------------------------------
# Port cho gateway (mặc định 18789)
OPENCLAW_GATEWAY_PORT=18789

# Port cho bridge service (mặc định 18790)
OPENCLAW_BRIDGE_PORT=18790

# Bind mode: "lan" (0.0.0.0) hoặc "loopback" (127.0.0.1)
# Dùng "lan" nếu Tailscale proxy chạy trong container khác, hoặc "loopback" nếu trên cùng host
OPENCLAW_GATEWAY_BIND=lan

# Auth token cho gateway — sinh tự động qua ./scripts/setup.sh
OPENCLAW_GATEWAY_TOKEN=

# -----------------------------------------------------------------------------
#  OpenClaw Auth Profiles (API Keys / OAuth)
# -----------------------------------------------------------------------------
# Codex / OpenAI Codex (OAuth — optional nếu dùng codex model)
# CODEX_EMAIL=user@domain.com

# OpenCode-Go (API key)
# OPENCODE_GO_API_KEY=sk-...

# OpenCode (API key)
# OPENCODE_API_KEY=sk-...

# -----------------------------------------------------------------------------
#  Google Chat Channel
# -----------------------------------------------------------------------------
# Service account JSON file — đặt trong config/ và trỏ path bên trong container
# GOOGLE_CHAT_SERVICE_ACCOUNT_PATH=/home/node/.openclaw/googlechat-service-account.json

# Webhook URL — PHẢI khớp chính xác với Google Cloud Console
# GOOGLE_CHAT_WEBHOOK_URL=https://<your-hostname>/googlechat

# App Principal (client_id từ service account JSON)
# GOOGLE_CHAT_APP_PRINCIPAL=123456789012345678901

# -----------------------------------------------------------------------------
#  Tailscale
# -----------------------------------------------------------------------------
# Auth key — tạo tại https://login.tailscale.com/admin/settings/keys
# Phải là reusable key hoặc one-off key cho node này
TS_AUTHKEY=

# Hostname hiển thị trên Tailscale admin console
TS_HOSTNAME=openclaw-gw

# Tailscale Serve port (HTTPS trong tailnet)
TS_SERVE_PORT=8443

# Tailscale Funnel path (public internet)
TS_FUNNEL_PATH=/googlechat

# Gateway address từ bên trong Tailscale container
# Với network_mode=host, 127.0.0.1 là localhost của host
TS_GATEWAY_ADDR=http://127.0.0.1:18789

# -----------------------------------------------------------------------------
#  n8n — Workflow Automation
# -----------------------------------------------------------------------------
# Port cho n8n (mặc định 5678)
N8N_PORT=5678

# Hostname / domain cho n8n
N8N_HOST=localhost

# Protocol: http hoặc https
N8N_PROTOCOL=http

# Webhook URL — set domain công khai nếu cần webhook từ bên ngoài
N8N_WEBHOOK_URL=http://localhost:5678/

# Encryption key — SINH TỰ ĐỘNG qua ./scripts/setup.sh
# Dùng để mã hóa credentials. ĐỂ TRỐNG để sinh tự động, hoặc tự tạo:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
#  Volume Mounts (nếu cần custom path)
# -----------------------------------------------------------------------------
# OPENCLAW_CONFIG_DIR=/path/to/config
# OPENCLAW_WORKSPACE_DIR=/path/to/workspace
